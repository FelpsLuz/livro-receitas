---
/**
 * Barra fixa (seção 9.1): marca + CRECI acima da dobra em todas as páginas,
 * navegação e botão de WhatsApp. Menu mobile por disclosure acessível.
 */
import AssinaturaLegal from "./AssinaturaLegal.astro";
import BotaoWhatsApp from "./BotaoWhatsApp.astro";

const itens = [
  { href: "/imoveis", rotulo: "Imóveis à venda" },
  { href: "/vendidos", rotulo: "Vendidos" },
  { href: "/sobre", rotulo: "Sobre" },
];

const caminho = Astro.url.pathname.replace(/\.html$/, "");
---

<header class="cabecalho">
  <div class="container cabecalho__linha">
    <a href="/" class="cabecalho__marca">
      <AssinaturaLegal variante="cabecalho" />
    </a>

    <button
      class="cabecalho__menu-botao"
      aria-expanded="false"
      aria-controls="menu-principal"
      data-menu-botao
    >
      <span class="visualmente-oculto">Abrir menu</span>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path class="icone-abrir" d="M3 6h18M3 12h18M3 18h18"></path>
        <path class="icone-fechar" d="M5 5l14 14M19 5L5 19" style="display:none"></path>
      </svg>
    </button>

    <nav class="cabecalho__nav" id="menu-principal" aria-label="Navegação principal" data-menu>
      <ul>
        {
          itens.map((item) => (
            <li>
              <a href={item.href} aria-current={caminho === item.href ? "page" : undefined}>
                {item.rotulo}
              </a>
            </li>
          ))
        }
        <li class="cabecalho__cta">
          <a href="/avaliacao" class="botao botao--sinal">Avaliar meu imóvel</a>
        </li>
        <li class="cabecalho__zap">
          <BotaoWhatsApp variante="contorno" />
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .cabecalho__linha {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--esp-4);
    min-height: 64px;
  }

  .cabecalho__marca {
    text-decoration: none;
    flex-shrink: 0;
  }

  .cabecalho__menu-botao {
    display: none;
    background: none;
    border: 1px solid var(--line);
    border-radius: var(--raio);
    padding: 0.5rem 0.6rem;
    cursor: pointer;
    color: var(--ink);
  }

  .cabecalho__nav ul {
    display: flex;
    align-items: center;
    gap: var(--esp-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cabecalho__nav a:not(.botao) {
    text-decoration: none;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    padding: 0.4rem 0.1rem;
    border-bottom: 2px solid transparent;
  }

  .cabecalho__nav a:not(.botao):hover,
  .cabecalho__nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  .cabecalho__nav .botao {
    min-height: 42px;
    font-size: 0.92rem;
    padding: 0.45em 1em;
  }

  @media (max-width: 63.94em) {
    .cabecalho__zap {
      display: none;
    }
  }

  @media (max-width: 47.94em) {
    .cabecalho__menu-botao {
      display: inline-flex;
    }

    .cabecalho__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 12px 24px rgba(13, 42, 51, 0.08);
    }

    .cabecalho__nav.aberto {
      display: block;
    }

    .cabecalho__nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--esp-3) clamp(1rem, 4vw, 2rem) var(--esp-5);
    }

    .cabecalho__nav li {
      border-bottom: 1px solid var(--surface-2);
    }

    .cabecalho__nav li:last-child,
    .cabecalho__nav li:nth-last-child(2) {
      border-bottom: 0;
    }

    .cabecalho__nav a:not(.botao) {
      display: block;
      padding: 0.85rem 0.1rem;
      font-size: 1.05rem;
    }

    .cabecalho__cta {
      padding-top: var(--esp-3);
    }

    .cabecalho__cta .botao,
    .cabecalho__zap :global(.botao) {
      width: 100%;
      margin-top: var(--esp-2);
    }

    .cabecalho__zap {
      display: block;
    }
  }
</style>

<script>
  const botao = document.querySelector<HTMLButtonElement>("[data-menu-botao]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (botao && menu) {
    const abrir = botao.querySelector<SVGPathElement>(".icone-abrir");
    const fechar = botao.querySelector<SVGPathElement>(".icone-fechar");
    const alternar = (aberto: boolean) => {
      botao.setAttribute("aria-expanded", String(aberto));
      menu.classList.toggle("aberto", aberto);
      if (abrir) abrir.style.display = aberto ? "none" : "";
      if (fechar) fechar.style.display = aberto ? "" : "none";
    };
    botao.addEventListener("click", () => {
      alternar(botao.getAttribute("aria-expanded") !== "true");
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && botao.getAttribute("aria-expanded") === "true") {
        alternar(false);
        botao.focus();
      }
    });
  }
</script>
