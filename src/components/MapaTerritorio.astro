---
/**
 * MAPA DO TERRITÓRIO v2 (Fase 5) — elemento-assinatura do site.
 * Geografia pela grade 12×12 do briefing de direção de arte; polígonos
 * simplificados com preenchimento por camada; marcos de veracidade
 * (Pq. das Águas, Av. Artur Bernardes, SP-079, Centro →). Navegável:
 * bairro → /regiao, ponto de condomínio → /condominio. Estados em CSS puro.
 * Em telas estreitas degrada para lista tocável agrupada por camada.
 */
import { getCollection } from "astro:content";
import { contagemPorBairro, vendasPorBairro } from "../lib/imoveis";
import {
  TERRITORIO,
  MARCOS,
  VIEWBOX,
  CAMADA_LABEL,
  CAMADA_CURTA,
  type Camada,
} from "../lib/territorio";

const contagem = await contagemPorBairro();
const vendas = await vendasPorBairro();
const bairrosComPagina = new Set((await getCollection("bairros")).map((b) => b.id));
const condominios = (await getCollection("condominios")).filter(
  (c) => typeof c.data.mapa_x === "number" && typeof c.data.mapa_y === "number"
);

const camadas: Camada[] = ["nucleo", "faixa-alta", "alto-padrao"];

function rotuloAcessivel(slug: string, nome: string): string {
  const partes: string[] = [];
  const d = contagem.get(slug) ?? 0;
  const v = vendas.get(slug) ?? 0;
  if (d > 0) partes.push(`${d} ${d === 1 ? "imóvel à venda" : "imóveis à venda"}`);
  if (v > 0) partes.push(`${v} ${v === 1 ? "venda concluída" : "vendas concluídas"}`);
  const resumo = partes.length ? `: ${partes.join(", ")}` : "";
  return `${nome}${resumo} — ver página do bairro`;
}

/** Linha de contadores centrada na âncora: pill de disponíveis + discos de venda. */
function linhaContadores(slug: string, ancora: { x: number; y: number }) {
  const d = contagem.get(slug) ?? 0;
  const v = Math.min(vendas.get(slug) ?? 0, 4);
  const pillW = d > 0 ? String(d).length * 7 + 15 : 0;
  const dotsW = v > 0 ? v * 13 + (d > 0 ? 8 : 0) : 0;
  const total = pillW + dotsW;
  const x0 = ancora.x - total / 2;
  return {
    pill: d > 0 ? { x: x0, w: pillW, n: d } : null,
    dots: Array.from({ length: v }, (_, i) => ({
      cx: x0 + pillW + (d > 0 ? 8 : 0) + 6 + i * 13,
    })),
    y: ancora.y,
  };
}

const linhaResumoLista = (slug: string): string[] => {
  const d = contagem.get(slug) ?? 0;
  const v = vendas.get(slug) ?? 0;
  const p: string[] = [];
  if (d > 0) p.push(`${d} à venda`);
  if (v > 0) p.push(`${v} ${v === 1 ? "vendido" : "vendidos"}`);
  return p;
};
---

<div class="mapa">
  <svg
    class="mapa__svg"
    viewBox={`0 0 ${VIEWBOX.largura} ${VIEWBOX.altura}`}
    role="group"
    aria-label="Mapa esquemático do território: vetor oeste e noroeste de Sorocaba"
  >
    <!-- marcos de base: vias e parque, sob os bairros -->
    <path class="mapa__via" d={MARCOS.avArturBernardes.path} />
    {MARCOS.sp079.linhas.map((d) => <path class="mapa__via mapa__via--rodovia" d={d} />)}
    {MARCOS.conectores.map((d) => <path class="mapa__via mapa__via--conector" d={d} />)}
    <path class="mapa__parque" d={MARCOS.parqueDasAguas.path} />
    <text class="mapa__marco-rotulo" x={MARCOS.parqueDasAguas.label.x} y={MARCOS.parqueDasAguas.label.y} text-anchor="middle">
      {MARCOS.parqueDasAguas.nome}
    </text>
    <text class="mapa__marco-rotulo" x={MARCOS.avArturBernardes.label.x} y={MARCOS.avArturBernardes.label.y} text-anchor="start">
      {MARCOS.avArturBernardes.nome}
    </text>
    <text
      class="mapa__marco-rotulo"
      x={MARCOS.sp079.label.x}
      y={MARCOS.sp079.label.y}
      text-anchor="middle"
      transform={`rotate(${MARCOS.sp079.label.rotacao} ${MARCOS.sp079.label.x} ${MARCOS.sp079.label.y})`}
    >
      {MARCOS.sp079.nome}
    </text>

    <!-- bairros -->
    {
      TERRITORIO.map((b) => {
        const temPagina = bairrosComPagina.has(b.slug);
        const contadores = linhaContadores(b.slug, b.ancora);
        const conteudo = (
          <>
            <path class:list={["mapa__forma", `mapa__forma--${b.camada}`]} d={b.path} />
            <text class="mapa__nome" x={b.label.x} y={b.label.y} text-anchor="middle">
              {b.labelLinhas.map((linha, i) => (
                <tspan x={b.label.x} dy={i === 0 ? 0 : 13}>
                  {linha}
                </tspan>
              ))}
            </text>
            {contadores.pill && (
              <g class="mapa__pill">
                <rect x={contadores.pill.x} y={contadores.y - 9} width={contadores.pill.w} height={18} rx={9} />
                <text x={contadores.pill.x + contadores.pill.w / 2} y={contadores.y + 3.5} text-anchor="middle">
                  {contadores.pill.n}
                </text>
              </g>
            )}
            {contadores.dots.map((p) => (
              <circle class="mapa__venda" cx={p.cx} cy={contadores.y} r="4.5" />
            ))}
          </>
        );
        return temPagina ? (
          <a href={`/regiao/${b.slug}`} class="mapa__bairro" aria-label={rotuloAcessivel(b.slug, b.nome)}>
            {conteudo}
          </a>
        ) : (
          <g class="mapa__bairro mapa__bairro--inerte">
            <title>{b.nome}</title>
            {conteudo}
          </g>
        );
      })
    }

    <!-- pontos de condomínio com página (links próprios, acima dos bairros) -->
    {
      condominios.map((c) => {
        const cx = ((c.data.mapa_x ?? 0) / 100) * VIEWBOX.largura;
        const cy = ((c.data.mapa_y ?? 0) / 100) * VIEWBOX.altura;
        return (
          <a href={`/condominio/${c.id}`} class="mapa__condo" aria-label={`Condomínio ${c.data.nome} — ver página`}>
            <circle cx={cx} cy={cy} r="10" fill="transparent" />
            <circle class="mapa__condo-ponto" cx={cx} cy={cy} r="5" />
          </a>
        );
      })
    }

    <!-- anotações -->
    <g class="mapa__centro" aria-hidden="true">
      <text x={MARCOS.centro.label.x} y={MARCOS.centro.label.y} text-anchor="end">CENTRO</text>
      <path d={`M ${MARCOS.centro.x - 58} ${MARCOS.centro.y} L ${MARCOS.centro.x} ${MARCOS.centro.y}`} />
      <path d={`M ${MARCOS.centro.x - 8} ${MARCOS.centro.y - 5} L ${MARCOS.centro.x} ${MARCOS.centro.y} L ${MARCOS.centro.x - 8} ${MARCOS.centro.y + 5}`} fill="none" />
    </g>
    <g class="mapa__norte" aria-hidden="true">
      <path d={`M ${MARCOS.norte.x} ${MARCOS.norte.y + 14} L ${MARCOS.norte.x} ${MARCOS.norte.y - 6}`} />
      <path d={`M ${MARCOS.norte.x - 5} ${MARCOS.norte.y + 1} L ${MARCOS.norte.x} ${MARCOS.norte.y - 8} L ${MARCOS.norte.x + 5} ${MARCOS.norte.y + 1}`} fill="none" />
      <text x={MARCOS.norte.x} y={MARCOS.norte.y + 30} text-anchor="middle">N</text>
    </g>
    <text class="mapa__nota" x="16" y={VIEWBOX.altura - 10} aria-hidden="true">mapa esquemático — sem escala</text>
  </svg>

  <p class="mapa__legenda" aria-hidden="true">
    <span class="mapa__leg-item"><span class="mapa__leg-pill dado">2</span> à venda no bairro</span>
    <span class="mapa__leg-item"><span class="mapa__leg-venda"></span> venda concluída</span>
    <span class="mapa__leg-item"><span class="mapa__leg-condo"></span> condomínio com página</span>
  </p>

  <!-- Fallback mobile: lista tocável agrupada por camada (Fase 5, 1.4) -->
  <nav class="mapa__lista" aria-label="Bairros do território">
    {
      camadas.map((camada) => (
        <section>
          <p class="rotulo mapa__lista-grupo" id={`mapa-camada-${camada}`}>
            {CAMADA_LABEL[camada]}
          </p>
          <ul role="list" aria-labelledby={`mapa-camada-${camada}`}>
            {TERRITORIO.filter((b) => b.camada === camada).map((b) => {
              const resumo = linhaResumoLista(b.slug);
              const miolo = (
                <>
                  <span class="mapa__linha-esq">
                    <span class="mapa__linha-nome">{b.nome}</span>
                    <span class="mapa__linha-camada">{CAMADA_CURTA[camada]}</span>
                  </span>
                  {resumo.length > 0 && (
                    <span class="mapa__linha-dir dado">
                      {resumo.map((t) => (
                        <span>{t}</span>
                      ))}
                    </span>
                  )}
                </>
              );
              return (
                <li>
                  {bairrosComPagina.has(b.slug) ? (
                    <a class="mapa__linha" href={`/regiao/${b.slug}`}>
                      {miolo}
                      <span class="mapa__linha-seta" aria-hidden="true">›</span>
                    </a>
                  ) : (
                    <span class="mapa__linha mapa__linha--inerte">{miolo}</span>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </nav>
</div>

<style>
  .mapa__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ===== vias e marcos ===== */
  .mapa__via {
    fill: none;
    stroke: var(--ink-line);
    stroke-opacity: 0.32;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 10 7;
  }

  .mapa__via--rodovia {
    stroke-opacity: 0.26;
    stroke-width: 2.5;
    stroke-dasharray: none;
  }

  .mapa__via--conector {
    stroke-opacity: 0.18;
    stroke-width: 1.5;
    stroke-dasharray: 7 6;
  }

  .mapa__parque {
    fill: var(--ok);
    fill-opacity: 0.15;
    stroke: var(--ok);
    stroke-opacity: 0.25;
    stroke-width: 1;
  }

  .mapa__marco-rotulo {
    font-family: var(--f-mono);
    font-size: 9px;
    letter-spacing: 0.06em;
    fill: var(--text-mid);
  }

  /* ===== bairros ===== */
  .mapa__bairro {
    cursor: pointer;
    outline: none;
  }

  .mapa__bairro--inerte {
    cursor: default;
  }

  .mapa__forma {
    stroke: var(--ink-line);
    stroke-width: 1.5;
    stroke-linejoin: round;
    fill: var(--ink);
    transition: fill-opacity 0.15s ease;
  }

  .mapa__forma--nucleo { fill-opacity: 0.1; }
  .mapa__forma--faixa-alta { fill-opacity: 0.05; }

  .mapa__forma--alto-padrao {
    fill-opacity: 0;
    stroke-dasharray: 5 4;
    stroke-opacity: 0.75;
  }

  a.mapa__bairro:hover .mapa__forma--nucleo,
  a.mapa__bairro:focus-visible .mapa__forma--nucleo { fill-opacity: 0.16; }

  a.mapa__bairro:hover .mapa__forma--faixa-alta,
  a.mapa__bairro:focus-visible .mapa__forma--faixa-alta { fill-opacity: 0.1; }

  a.mapa__bairro:hover .mapa__nome,
  a.mapa__bairro:focus-visible .mapa__nome { font-weight: 700; }

  a.mapa__bairro:focus-visible .mapa__forma {
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-dasharray: none;
  }

  .mapa__nome {
    font-family: var(--f-display);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--ink);
  }

  .mapa__bairro--inerte .mapa__nome {
    fill: var(--text-mid);
    font-size: 10px;
  }

  .mapa__pill rect {
    fill: var(--surface);
    stroke: var(--line);
    stroke-width: 1;
  }

  .mapa__pill text {
    font-family: var(--f-mono);
    font-size: 10px;
    font-weight: 500;
    fill: var(--ink);
  }

  .mapa__venda {
    fill: var(--off);
  }

  .mapa__condo {
    outline: none;
  }

  .mapa__condo-ponto {
    fill: var(--ink);
    stroke: #fff;
    stroke-width: 2;
    transition: r 0.15s ease;
  }

  .mapa__condo:hover .mapa__condo-ponto,
  .mapa__condo:focus-visible .mapa__condo-ponto {
    stroke: var(--signal);
  }

  /* ===== anotações ===== */
  .mapa__centro text,
  .mapa__norte text {
    font-family: var(--f-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--text-mid);
  }

  .mapa__centro path,
  .mapa__norte path {
    stroke: var(--text-mid);
    stroke-width: 1.5;
    fill: none;
  }

  .mapa__nota {
    font-family: var(--f-mono);
    font-size: 9px;
    fill: var(--text-mid);
  }

  /* ===== legenda ===== */
  .mapa__legenda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--esp-2) var(--esp-5);
    margin-top: var(--esp-3);
    font-size: 0.8rem;
    color: var(--text-mid);
    max-width: none;
  }

  .mapa__leg-item {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
  }

  .mapa__leg-pill {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 18px;
    padding-inline: 5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.68rem;
    color: var(--ink);
  }

  .mapa__leg-venda,
  .mapa__leg-condo {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .mapa__leg-venda { background: var(--off); }

  .mapa__leg-condo {
    background: var(--ink);
    box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--line);
  }

  /* ===== fallback mobile: lista tocável ===== */
  .mapa__lista {
    display: none;
  }

  @media (max-width: 35.94em) {
    .mapa__svg,
    .mapa__legenda {
      display: none;
    }

    .mapa__lista {
      display: block;
    }

    .mapa__lista-grupo {
      margin: var(--esp-5) 0 var(--esp-1);
      font-size: 0.72rem;
    }

    .mapa__lista section:first-child .mapa__lista-grupo {
      margin-top: 0;
    }

    .mapa__lista ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .mapa__lista li + li .mapa__linha {
      border-top: 1px solid var(--line);
    }

    .mapa__linha {
      display: flex;
      align-items: center;
      gap: var(--esp-3);
      min-height: 56px;
      text-decoration: none;
      color: inherit;
      padding-block: var(--esp-2);
    }

    .mapa__linha-esq {
      display: grid;
      gap: 4px;
      justify-items: start;
    }

    .mapa__linha-nome {
      font-family: var(--f-display);
      font-weight: 600;
      font-size: 1rem;
      color: var(--ink);
    }

    .mapa__linha--inerte .mapa__linha-nome {
      color: var(--text-mid);
      font-weight: 500;
    }

    .mapa__linha-camada {
      font-size: 0.68rem;
      color: var(--text-mid);
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 0.05rem 0.55rem;
      white-space: nowrap;
    }

    .mapa__linha-dir {
      margin-left: auto;
      display: grid;
      gap: 2px;
      justify-items: end;
      font-size: 0.75rem;
      color: var(--text-mid);
      text-align: right;
      white-space: nowrap;
    }

    .mapa__linha-seta {
      margin-left: auto;
      font-size: 1.35rem;
      line-height: 1;
      color: var(--text-mid);
    }

    .mapa__linha-dir + .mapa__linha-seta {
      margin-left: var(--esp-2);
    }

    a.mapa__linha:active .mapa__linha-nome,
    a.mapa__linha:hover .mapa__linha-nome {
      color: var(--ink-2);
    }
  }
</style>
