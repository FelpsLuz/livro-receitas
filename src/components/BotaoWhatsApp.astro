---
/**
 * Único caminho de contato telefônico do site (regra 8.5): o número vive
 * apenas no href do wa.me — nunca como texto visível.
 * O clique dispara `whatsapp_click` com ref/status via delegação no layout.
 */
import { linkWhatsApp } from "../lib/whatsapp";

interface Props {
  mensagem?: string;
  rotulo?: string;
  variante?: "sinal" | "tinta" | "contorno";
  largo?: boolean;
  refImovel?: string;
  statusImovel?: string;
}

const {
  mensagem,
  rotulo = "Falar no WhatsApp",
  variante = "tinta",
  largo = false,
  refImovel,
  statusImovel,
} = Astro.props;
---

<a
  class:list={["botao", `botao--${variante}`, { "botao--largo": largo }]}
  href={linkWhatsApp(mensagem)}
  target="_blank"
  rel="noopener"
  data-whatsapp
  data-ref={refImovel}
  data-status={statusImovel}
>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
    <path
      d="M12 2a10 10 0 0 0-8.66 15L2 22l5.16-1.32A10 10 0 1 0 12 2Zm0 18.13a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.06.79.81-2.99-.2-.31A8.13 8.13 0 1 1 12 20.13Zm4.46-6.08c-.24-.12-1.44-.71-1.67-.79s-.39-.12-.55.12-.63.79-.77.95-.28.18-.53.06a6.65 6.65 0 0 1-1.96-1.21 7.33 7.33 0 0 1-1.35-1.68c-.14-.24 0-.37.11-.5s.24-.28.37-.42a1.66 1.66 0 0 0 .24-.41.45.45 0 0 0 0-.43c-.06-.12-.55-1.32-.75-1.81s-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.73 2.73 0 0 0-.85 2 4.74 4.74 0 0 0 1 2.52 10.88 10.88 0 0 0 4.16 3.68 14.1 14.1 0 0 0 1.39.51 3.35 3.35 0 0 0 1.53.1 2.5 2.5 0 0 0 1.64-1.16 2 2 0 0 0 .14-1.16c-.06-.1-.22-.16-.46-.28Z"
    ></path>
  </svg>
  {rotulo}
</a>
